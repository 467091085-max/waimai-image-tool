         pass
+
+
+def main() -> int:
+    try:
+        with postgres_connection() as connection:
+            result = run_postgres_migrations(connection)
+    except (PostgresMigrationError, PostgresRuntimeError) as exc:
+        payload = {
+            "ok": False,
+            "code": exc.code,
+        }
+        version = str(getattr(exc, "version", "") or "")
+        cause_type = str(getattr(exc, "cause_type", "") or "")
+        if version:
+            payload["version"] = version
+        if cause_type:
+            payload["causeType"] = cause_type
+        print(json.dumps(payload, sort_keys=True), file=sys.stderr)
+        return 1
+    except Exception as exc:
+        print(
+            json.dumps(
+                {
+                    "ok": False,
+                    "code": "migration_unexpected_failure",
+                    "causeType": type(exc).__name__,
+                },
+                sort_keys=True,
+            ),
+            file=sys.stderr,
+        )
+        return 1
+
+    print(
+        json.dumps(
+            {
+                "ok": True,
+                "discoveredVersions": list(result.discovered_versions),
+                "previouslyAppliedVersions": list(
+                    result.previously_applied_versions
+                ),
+                "appliedVersions": list(result.applied_versions),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
